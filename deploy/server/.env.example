# Vibe Plan production server configuration
#
# Usage:
#   cp .env.example .env
#   # Fill every replace-with-* value and the Alipay credentials.
#   ./deploy.sh
#
# This file is safe to commit. deploy/server/.env is ignored by Git and must
# remain only on the server. Never place private keys in image build arguments.

# 1. Container image, domain, and Traefik network
# The deployment script pulls these CCR images and attaches the web service to
# the existing Traefik network. VIBE_PLAN_VERSION selects the image tag.
VIBE_PLAN_REGISTRY=ccr.ccs.tencentyun.com
VIBE_PLAN_NAMESPACE=jayden
VIBE_PLAN_VERSION=0.1.0
VIBE_PLAN_DOMAIN=vibeplan.szxinjin.cn
TRAEFIK_NETWORK=traefik-public
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://vibeplan.szxinjin.cn

# 2. PostgreSQL container data
# Values initialize the database container. Keep POSTGRES_PASSWORD stable after
# the first deployment or existing data will no longer be accessible.
POSTGRES_DB=vibe_plan
POSTGRES_USER=vibe
POSTGRES_PASSWORD=replace-with-a-long-password

# 3. Authentication, registration, and platform administration
# AUTH_ACCESS_SECRET signs sessions and must be a long random value. Users keep
# an active session for 90 days through refresh-token rotation.
AUTH_ACCESS_SECRET=replace-with-a-long-random-secret
# The API is behind the bundled reverse proxy; keep this true so rate limits use client IPs.
TRUST_PROXY=true
AUTH_ACCESS_TOKEN_TTL=30m
AUTH_REFRESH_TOKEN_TTL=90d
# false allows direct registration; true sends and requires an email code.
EMAIL_VERIFICATION_REQUIRED=false
# Comma-separated registered emails that bootstrap super administrators.
PLATFORM_ADMIN_EMAILS=

# 4. SMTP delivery
# Required when EMAIL_VERIFICATION_REQUIRED=true or password resets are used.
# APP_BASE_URL builds reset links; all values must be complete before the API
# reports an email as sent. Use the provider's SMTP host and credentials.
APP_BASE_URL=https://vibeplan.szxinjin.cn
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vibe.local

# 5. Organization subscriptions and Alipay Web Pay
# Set BILLING_PROVIDER=alipay only after all credentials are filled. The notify
# URL must be public and configured identically in Alipay Open Platform. Replace
# ORGANIZATION_ID in the return URL is handled by the application at checkout.
BILLING_PROVIDER=alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=https://vibeplan.szxinjin.cn/api/billing/alipay/notify
ALIPAY_RETURN_URL=https://vibeplan.szxinjin.cn/organizations/ORGANIZATION_ID/billing/return
