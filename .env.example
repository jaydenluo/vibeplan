# Vibe Plan local development configuration
#
# Usage:
#   cp .env.example .env
#   ./start.sh
#
# This file is safe to commit. `.env` is local-only and may contain secrets.
# For Docker/production settings, use deploy/server/.env instead.

# 1. Local service and database connection
# DATABASE_URL points to the PostgreSQL instance used by the API and tests.
# ./start.sh reads this port and starts the local Docker database if needed.
DATABASE_URL=postgres://vibe:vibe@localhost:5432/vibe_plan
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Comma-separated browser origins. Production must set this explicitly.
CORS_ORIGINS=http://localhost:5173

# 2. Authentication and registration
# Change AUTH_ACCESS_SECRET for any shared environment. Access tokens are short
# lived; the refresh token keeps an active login valid for 30 days.
AUTH_ACCESS_SECRET=replace-with-a-long-random-secret
# Set true only when the API is behind a trusted reverse proxy (for example the bundled Nginx).
TRUST_PROXY=false
AUTH_ACCESS_TOKEN_TTL=30m
AUTH_REFRESH_TOKEN_TTL=30d
# true requires users to enter an emailed registration code; false registers directly.
EMAIL_VERIFICATION_REQUIRED=true

# 3. Platform administrator bootstrap
# Comma-separated, already registered email addresses. Leave blank for ordinary
# local development. This is evaluated when the user next accesses admin APIs.
PLATFORM_ADMIN_EMAILS=

# 4. Local mail delivery
# The default Mailpit/MailHog-compatible values only support local testing.
# Set real SMTP values only in a private server .env file.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vibe.local

# 5. Subscription and payment testing
# Local development uses manual test confirmation. Do not put Alipay production
# keys in this file or expose any payment values through VITE_* variables.
BILLING_PROVIDER=manual
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=https://vibeplan.szxinjin.cn/api/billing/alipay/notify
ALIPAY_RETURN_URL=https://vibeplan.szxinjin.cn/organizations/ORGANIZATION_ID/billing/return
